{
  "name": "delugerpg-desktop-client",
  "version": "1.3.4",
  "description": "Standalone Stealth Desktop Client for DelugeRPG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "electronVersion": "39.0.0",
    "appId": "com.antigravity.delugerpg.client",
    "productName": "DelugeRPG Stealth Client",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DelugeRPG Stealth Client",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "app.html",
      "app.js",
      "game-preload.js",
      "targets.js",
      "team_engine.js",
      "gym_leaders.json",
      "skills_database.json",
      "type_chart_database.json",
      "user_collection.json",
      "daily_catch_log.json",
      "config.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "delugerpg",
    "stealth",
    "client"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
